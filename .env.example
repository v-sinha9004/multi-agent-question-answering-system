# =============================================================================
# Multi-Agent Question-Answering System - Environment Configuration
# =============================================================================
# Instructions:
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. Fill in your actual configuration values below.
# =============================================================================

# OpenAI API Key (required for live OpenAI model execution)
# Format: sk-proj-... or sk-...
# If left blank, the system runs in offline simulation (mock) mode.
OPENAI_API_KEY=

# OpenAI Model Name (optional, defaults to gpt-4o)
# Examples: gpt-4o, gpt-4o-mini, gpt-4-turbo, o3-mini
OPENAI_MODEL=gpt-4o

# Custom OpenAI-compatible API base URL (optional)
# Useful for local LLMs, proxies, or compatible endpoints (e.g. Ollama, OpenRouter, vLLM)
# OPENAI_BASE_URL=https://api.openai.com/v1
